    "Gente %@ · DeskHead Inc.": {
      "shouldTranslate": false
    },
    "Gente Cloud (DeskHead Inc.): the AI answer. Not stored, not used for training.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
