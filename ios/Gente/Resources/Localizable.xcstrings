    "Chats, memory, routines and the log are erased, and the key is replaced. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran los chats, la memoria, las rutinas y el registro, y se cambia la clave. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas, memória, rotinas e o registro são apagados, e a chave é trocada. Não dá para desfazer."
          }
        }
      }
    },
    "Check that your computer shows this code:": {
