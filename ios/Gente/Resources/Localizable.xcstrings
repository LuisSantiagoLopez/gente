    "Each question sends only what it needs. Our servers answer and keep nothing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pregunta envía solo lo necesario. Nuestros servidores responden y no guardan nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pergunta envia só o necessário. Nossos servidores respondem e não guardam nada."
          }
        }
      }
    },
    "ElevenLabs: text to read aloud, if you turn on the cloud voice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ElevenLabs: texto para leer en voz alta, si activas la voz en la nube."
