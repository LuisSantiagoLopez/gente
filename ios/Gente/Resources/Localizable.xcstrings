    "Delete your Gente account?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar tu cuenta de Gente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta do Gente?"
          }
        }
      }
    },
    "Deleting your account removes it from Gente Cloud and erases everything Gente keeps on this iPhone. Subscriptions bought through Apple are managed in your Apple Account settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar tu cuenta la quita de Gente Cloud y borra todo lo que Gente guarda en este iPhone. Las suscripciones compradas con Apple se administran en los ajustes de tu Cuenta de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta a remove do Gente Cloud e apaga tudo o que o Gente guarda neste iPhone. Assinaturas compradas pela Apple são gerenciadas nos ajustes da sua Conta Apple."
          }
        }
      }
    },
    "Deletion receipts appear here once Gente Cloud sends them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comprobantes de borrado aparecen aquí cuando Gente Cloud los envía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comprovantes de exclusão aparecem aqui quando o Gente Cloud os envia."
          }
        }
      }
    },
