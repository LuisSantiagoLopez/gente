{
  "name": "@rakazo/desktop",
  "productName": "Your AI",
  "version": "1.0.7",
  "author": {
    "name": "DeskHead Inc."
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node ../../scripts/gente-plans.mjs && node scripts/build.mjs && node scripts/copy-static.mjs && node scripts/build-speech.mjs && node scripts/copy-koffi.mjs",
    "pack": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.jsdom.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@rakazo/contracts": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.12",
    "koffi": "3.3.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rakazo/adapters": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/ui-tokens": "workspace:*",
    "@types/qrcode": "1.5.5",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.gente.app",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/koffi",
        "to": "koffi"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "name": "gente",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "{**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node,**/node_modules/@oxc-parser/binding-darwin-*/parser.darwin-*.node}",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gente uses the microphone for dictation and voice calls with your bots.",
        "NSSpeechRecognitionUsageDescription": "Gente turns what you say into text for dictation and voice calls with your bots."
      },
      "extraResources": [
        {
          "from": "build/speech/rakazo-speech",
          "to": "speech/rakazo-speech"
        },
        {
          "from": "assets/es.lproj",
          "to": "es.lproj"
        },
        {
          "from": "assets/pl.lproj",
          "to": "pl.lproj"
        },
        {
          "from": "build/server-bundle.json",
          "to": "server-bundle.json"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": false,
      "artifactName": "Your-AI-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 490,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "Your-AI-Setup-${version}.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "extraResources": [
        {
          "from": "build/server-bundle.json",
          "to": "server-bundle.json"
        }
      ]
    },
    "linux": {
      "executableName": "gente",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuisSantiagoLopez",
        "repo": "gente"
      }
    ],
    "copyright": "Copyright 2026 DeskHead Inc. Based on Rakazo by Elie Steinbock (Apache-2.0).",
    "afterPack": "scripts/gente-after-pack.cjs"
  },
  "description": "Gente: the AI of the people. Private AI coworkers that run on your computer. Based on Rakazo by Elie Steinbock (Apache-2.0)."
}
